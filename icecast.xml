<icecast>
    <location>Super Radio Studio</location>
    <admin>admin@super-radio.com</admin>
    
    <limits>
        <clients>100</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
    </limits>
    
    <authentication>
        <source-password>superpass</source-password>
        <relay-password>relaypass</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>adminpass</admin-password>
    </authentication>
    
    <hostname>0.0.0.0</hostname>
    
    <listen-socket>
        <port>8000</port>
        <bind-address>0.0.0.0</bind-address>
    </listen-socket>
    
    <mount>
        <mount-name>/stream</mount-name>
        <max-listeners>100</max-listeners>
        <public>1</public>
        <stream-name>SUPER RADIO</stream-name>
        <stream-description>24/7 Internet Radio - Best Music!</stream-description>
        <stream-url>http://radio.super:8000/stream</stream-url>
        <genre>Various</genre>
        <bitrate>128</bitrate>
        <type>audio/mpeg</type>
    </mount>
    
    <fileserve>1</fileserve>
    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
    </paths>
    
    <logging>
        <accesslog>/var/log/icecast2/access.log</accesslog>
        <errorlog>/var/log/icecast2/error.log</errorlog>
        <loglevel>3</loglevel>
    </logging>
</icecast>
